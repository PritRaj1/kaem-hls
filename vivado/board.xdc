# Board: Kintex7_Base / OpenSourceSDRLab-class XC7K325T-FFG676

# Config
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
set_property BITSTREAM.CONFIG.SPI_BUSWIDTH 4 [current_design]
set_property CONFIG_MODE SPIx4 [current_design]
set_property BITSTREAM.CONFIG.CONFIGRATE 50 [current_design]
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
set_property BITSTREAM.CONFIG.UNUSEDPIN Pullup [current_design]

# Clock / reset
set_property PACKAGE_PIN G22 [get_ports ap_clk]
set_property IOSTANDARD LVCMOS33 [get_ports ap_clk]
create_clock -period 20.000 -name ap_clk [get_ports ap_clk]

set_property PACKAGE_PIN D26 [get_ports ap_rst_n]
set_property IOSTANDARD LVCMOS33 [get_ports ap_rst_n]

# Stream/sim ports
set_property IOSTANDARD LVCMOS33 [get_ports {s_axis_0_tdata[*]}]
set_property IOSTANDARD LVCMOS33 [get_ports s_axis_0_tvalid]
set_property IOSTANDARD LVCMOS33 [get_ports s_axis_0_tready]
set_property IOSTANDARD LVCMOS33 [get_ports {m_axis_0_tdata[*]}]
set_property IOSTANDARD LVCMOS33 [get_ports m_axis_0_tvalid]
set_property IOSTANDARD LVCMOS33 [get_ports m_axis_0_tready]
set_property IOSTANDARD LVCMOS33 [get_ports sim_finish]

# s_axis_0
set_property PACKAGE_PIN K25 [get_ports {s_axis_0_tdata[0]}]
